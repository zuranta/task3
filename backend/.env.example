# Non-secret settings only. Never commit a populated .env file (constitution Principle II).
#
# Azure OpenAI: reuses the existing aoai-jab4fcusuxtqs resource; this project does not
# provision its own Azure OpenAI account.
AZURE_OPENAI_ENDPOINT=https://aoai-jab4fcusuxtqs.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.1

# Azure AI Search: the one new resource this project provisions (Free tier).
# Value comes from the `infra/main.bicep` deployment output.
AZURE_SEARCH_ENDPOINT=https://<your-new-search-resource>.search.windows.net
AZURE_SEARCH_INDEX_NAME=rag-documents

# Key Vault: holds the JWT signing secret and the LangSmith API key at runtime.
# Value comes from the `infra/main.bicep` deployment output.
# The JWT secret is written into this vault automatically by keyvault.bicep at
# provision time. The LangSmith API key must be set manually once, e.g.:
#   az keyvault secret set --vault-name <vault-name> --name LangSmithApiKey --value <key>
# See quickstart.md's Infrastructure section for the full one-time setup steps.
KEY_VAULT_URI=https://<your-new-keyvault>.vault.azure.net/

# Application Insights (non-secret connection string).
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<from-bicep-output>

# All Azure calls above authenticate via DefaultAzureCredential, which resolves to your
# `az login` session for local development and will resolve to a managed identity
# automatically once App Service hosting is added, with no code change.
